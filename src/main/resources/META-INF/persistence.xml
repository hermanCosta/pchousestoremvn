<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="pcHouseStorePU" transaction-type="RESOURCE_LOCAL">
        <class>com.pchouse.pchousestoremvn.models.Company</class>
        <class>com.pchouse.pchousestoremvn.models.Customerr</class>
        <class>com.pchouse.pchousestoremvn.models.Deposit</class>
        <class>com.pchouse.pchousestoremvn.models.Device</class>
        <class>com.pchouse.pchousestoremvn.models.Employee</class>
        <class>com.pchouse.pchousestoremvn.models.Fault</class>
        <class>com.pchouse.pchousestoremvn.models.Person</class>
        <class>com.pchouse.pchousestoremvn.models.ProductService</class>
        <class>com.pchouse.pchousestoremvn.models.Refund</class>
        <class>com.pchouse.pchousestoremvn.models.Refurb</class>
        <class>com.pchouse.pchousestoremvn.models.Sale</class>
        <class>com.pchouse.pchousestoremvn.models.SaleProdServ</class>
        <class>com.pchouse.pchousestoremvn.models.ServiceOrder</class>
        <class>com.pchouse.pchousestoremvn.models.ServiceOrderFault</class>
        <class>com.pchouse.pchousestoremvn.models.ServiceOrderNote</class>
        <class>com.pchouse.pchousestoremvn.models.ServiceOrderPayment</class>
        <class>com.pchouse.pchousestoremvn.models.ServiceOrderProdServ</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/PC_HOUSE_STORE"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="hellmans"/>
            
            <!-- Configurações do Hibernate -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
