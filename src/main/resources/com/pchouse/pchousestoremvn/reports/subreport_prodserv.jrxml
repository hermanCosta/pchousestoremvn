<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport_prodserv" pageWidth="555" pageHeight="100" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="f49e8e74-e245-4ef1-9e49-3b596c815d9c">

    <!-- Fields -->
    <field name="description" class="java.lang.String"/>
    <field name="unitPrice" class="java.lang.Double"/>
    <field name="quantity" class="java.lang.Integer"/>

    <!-- Column Headers -->
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="250" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="80" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Quantity]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="0" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="0" width="95" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Rows -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="250" height="20"/>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="€ #,##0.00">
                <reportElement x="350" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField pattern="€ #,##0.00">
                <reportElement x="460" y="0" width="95" height="20"/>
                <textFieldExpression><![CDATA[$F{unitPrice} * $F{quantity}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
