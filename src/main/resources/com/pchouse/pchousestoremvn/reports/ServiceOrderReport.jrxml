<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ServiceOrderReport" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="123e4567-e89b-12d3-a456-426614174000">

    <!-- Parameters -->
    <parameter name="orderId" class="java.lang.Long"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="customerEmail" class="java.lang.String"/>
    <parameter name="customerPhone" class="java.lang.String"/>
    <parameter name="brand" class="java.lang.String"/>
    <parameter name="model" class="java.lang.String"/>
    <parameter name="serialNumber" class="java.lang.String"/>
    <parameter name="deposit" class="java.lang.Double"/>
    <parameter name="total" class="java.lang.Double"/>
    <parameter name="remaining" class="java.lang.Double"/>
    <parameter name="notes" class="java.lang.String"/>
    <parameter name="faultsConcatenated" class="java.lang.String"/>
    <parameter name="prodServDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String"/>

    <!-- Title -->
    <title>
        <band height="40">
            <textField>
                <reportElement x="0" y="5" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["SERVICE ORDER #" + $P{orderId}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Detail -->
    <detail>
        <band height="700">

            <!-- Customer Information -->
            <staticText>
                <reportElement x="0" y="0" width="555" height="18"/>
                <textElement>
                    <font isBold="true" size="14"/>
                </textElement>
                <text><![CDATA[Customer Information]]></text>
            </staticText>
            <textField><reportElement x="0" y="20" width="555" height="16"/>
                <textFieldExpression><![CDATA["Name: " + $P{customerName}]]></textFieldExpression>
            </textField>
            <textField><reportElement x="0" y="36" width="555" height="16"/>
                <textFieldExpression><![CDATA["Email: " + $P{customerEmail}]]></textFieldExpression>
            </textField>
            <textField><reportElement x="0" y="52" width="555" height="16"/>
                <textFieldExpression><![CDATA["Phone: " + $P{customerPhone}]]></textFieldExpression>
            </textField>

            <!-- Device Info -->
            <staticText>
                <reportElement x="0" y="72" width="555" height="18"/>
                <textElement>
                    <font isBold="true" size="14"/>
                </textElement>
                <text><![CDATA[Device Information]]></text>
            </staticText>
            <textField><reportElement x="0" y="92" width="555" height="16"/>
                <textFieldExpression><![CDATA["Brand: " + $P{brand}]]></textFieldExpression>
            </textField>
            <textField><reportElement x="0" y="108" width="555" height="16"/>
                <textFieldExpression><![CDATA["Model: " + $P{model}]]></textFieldExpression>
            </textField>
            <textField><reportElement x="0" y="124" width="555" height="16"/>
                <textFieldExpression><![CDATA["Serial Number: " + $P{serialNumber}]]></textFieldExpression>
            </textField>

            <!-- Faults -->
            <staticText>
                <reportElement x="0" y="144" width="555" height="18"/>
                <textElement>
                    <font isBold="true" size="14"/>
                </textElement>
                <text><![CDATA[Reported Faults]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="164" width="555" height="36"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{faultsConcatenated}]]></textFieldExpression>
            </textField>

            <!-- Products & Services -->
            <staticText>
                <reportElement x="0" y="206" width="555" height="18"/>
                <textElement>
                    <font isBold="true" size="14"/>
                </textElement>
                <text><![CDATA[Products & Services]]></text>
            </staticText>
            <subreport>
                <reportElement x="0" y="226" width="555" height="80"/>
                <subreportParameter name="REPORT_DATA_SOURCE">
                    <subreportParameterExpression><![CDATA[$P{prodServDataSource}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "subreport_prodserv.jasper"]]></subreportExpression>
            </subreport>

            <!-- Financial Summary -->
            <staticText>
                <reportElement x="0" y="316" width="555" height="18"/>
                <textElement>
                    <font isBold="true" size="14"/>
                </textElement>
                <text><![CDATA[Financial Summary]]></text>
            </staticText>
            <textField pattern="€ #,##0.00">
                <reportElement x="0" y="336" width="555" height="16"/>
                <textFieldExpression><![CDATA[$P{deposit}]]></textFieldExpression>
            </textField>
            <textField pattern="€ #,##0.00">
                <reportElement x="0" y="352" width="555" height="16"/>
                <textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
            </textField>
            <textField pattern="€ #,##0.00">
                <reportElement x="0" y="368" width="555" height="16"/>
                <textFieldExpression><![CDATA[$P{remaining}]]></textFieldExpression>
            </textField>

            <!-- Notes -->
            <staticText>
                <reportElement x="0" y="392" width="555" height="18"/>
                <textElement>
                    <font isBold="true" size="14"/>
                </textElement>
                <text><![CDATA[Important Notes]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="412" width="555" height="60"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{notes}]]></textFieldExpression>
            </textField>

            <!-- Consent -->
            <staticText>
                <reportElement x="0" y="478" width="555" height="30"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <text><![CDATA[Consent: I hereby authorize the evaluation and necessary service for the equipment described above. I acknowledge the terms and the estimated costs presented.]]></text>
            </staticText>

            <!-- Signature -->
            <staticText>
                <reportElement x="0" y="510" width="280" height="16"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Customer Signature: _______________________________]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="510" width="155" height="16"/>
                <textElement textAlignment="Right">
                    <font size="11"/>
                </textElement>
                <text><![CDATA[Date: ____ / ____ / ______]]></text>
            </staticText>

        </band>
    </detail>
</jasperReport>